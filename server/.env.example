# Optional server port (defaults to 2567):
# PORT=2567

# WebRTC ICE configuration. STUN works locally without these values; the
# default public STUN server is used when WEBRTC_STUN_URLS is blank.
# WEBRTC_STUN_URLS=stun:stun.example.com:3478
# WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# WEBRTC_TURN_USERNAME=replace-with-turn-username
# WEBRTC_TURN_CREDENTIAL=replace-with-turn-credential
# Preferred for coturn TURN REST authentication: creates a one-hour
# credential per Colyseus session instead of delivering the shared secret.
# WEBRTC_TURN_SHARED_SECRET=replace-with-coturn-static-auth-secret
