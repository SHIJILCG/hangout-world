{
  "name": "hangout-world-client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "test": "vitest run --configLoader runner",
    "generate:meadow": "node scripts/meadow/generate.mjs",
    "generate:cottage-lod": "node scripts/cottage-lod.mjs",
    "generate:expansion-assets": "node scripts/export-expansion-assets.mjs",
    "validate:meadow": "node scripts/meadow/validate.mjs",
    "test:meadow": "node --test scripts/meadow/meadow.check.mjs scripts/meadow/expansion.check.mjs",
    "generate:village-assets": "node scripts/export-village-assets.mjs"
  },
  "dependencies": {
    "colyseus.js": "^0.16.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "happy-dom": "^15.11.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
